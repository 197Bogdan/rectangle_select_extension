{
  "name": "Rectangle Select",
  "description": "Allows you to select text in a rectangle form.",
  "version": "1.0.0",
  "manifest_version": 3,
  "action": {
    "default_title": "Rectangle Selection",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "rectangle-selection@example.com"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "commands": {
    "toggle-rectangle-selection": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Toggle Rectangle Selection"
    }
  }
}